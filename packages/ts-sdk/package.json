{
  "name": "@timmydev56/hera-ts-sdk",
  "version": "0.1.5",
  "description": "Standalone TypeScript SDK for Hera privacy compliance workflows",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Hera-Protocol/Hera.git",
    "directory": "packages/ts-sdk"
  },
  "homepage": "https://github.com/Hera-Protocol/Hera/tree/main/packages/ts-sdk",
  "bugs": {
    "url": "https://github.com/Hera-Protocol/Hera/issues"
  },
  "keywords": [
    "hera",
    "privacy",
    "compliance",
    "zcash",
    "namada",
    "wasm",
    "sdk"
  ],
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "publishConfig": {
    "access": "public"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "clean": "rm -rf dist ../sdk-wasm/dist",
    "build:wasm": "wasm-pack build ../sdk-wasm --target bundler --out-dir $(pwd)/dist/wasm --out-name hera_sdk_wasm",
    "postbuild:wasm": "rm -f dist/wasm/.gitignore dist/wasm/package.json",
    "build": "npm run clean && npm run build:wasm && npm run postbuild:wasm && tsc -p tsconfig.json",
    "prepack": "npm run build",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  }
}
